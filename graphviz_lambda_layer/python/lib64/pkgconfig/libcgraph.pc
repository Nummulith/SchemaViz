prefix=/opt/graphviz
exec_prefix=/opt/graphviz
libdir=/opt/graphviz/lib
includedir=/opt/graphviz/include/graphviz

Name: libcgraph
Description: Graph library (file i/o, dot language parsing, graph, subgraph, node, edge, attribute, data structure manipulation)
Version: 2.46.0
Libs: -L${libdir} -lcgraph -lcdt
Cflags: -I${includedir}
